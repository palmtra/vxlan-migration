# Paste into vars/vlans/{{ report.data_center }}.yml — generated by discovery
# VLAN {{ report.vlan_id }} ({{ report.vlan_name }})
# Switches with learned MACs: {{ report.switches_with_mac_learning | default([]) | join(', ') if report.switches_with_mac_learning | default([]) | length > 0 else 'none' }}

vlans:
  - id: {{ report.vlan_id }}
    name: {{ report.vlan_name }}
    action: migrate
    service_type: {{ report.service_type | default('l3') }}
    vrf: {{ report.vrf | default('default') }}
    vni: 0  # TODO: assign before migration
    target_switches:
{{ (report.switches_with_mac_learning | default(report.switches_found) | default([])) | map('regex_replace', '^', '      - ') | join('\n') if (report.switches_with_mac_learning | default(report.switches_found) | default([])) | length > 0 else '      []' }}
    discovery_switches:
{{ (report.switches_found | default([])) | map('regex_replace', '^', '      - ') | join('\n') if report.switches_found | default([]) | length > 0 else '      []' }}
