# Paste as vars/vlans/{{ report.data_center }}/{{ report.vlan_id | vlan_db_record_filename(report.vlan_name) }}
# VLAN {{ report.vlan_id }} ({{ report.vlan_name }}) - generated by discovery
# On-box name: {{ report.vlan_name_on_box | default('(not parsed)') }}
# Inferred service_type: {{ report.inferred_service_type | default(report.service_type) }}
# Discovered VRF: {{ report.discovered_vrf | default(report.vrf) }}
# Gateway: {{ report.gateway | default('(none)') }}
# Prefixes: {{ report.prefixes | default([]) | join(', ') if report.prefixes | default([]) else '(none)' }}
# Switches with learned MACs: {{ report.switches_with_mac_learning | default([]) | join(', ') if report.switches_with_mac_learning | default([]) | length > 0 else 'none' }}
# target_switches: EOS leaves for CVP configlet push (confirm before migrate)
# vni: assign before migration — discovery cannot infer VNI

id: {{ report.vlan_id }}
name: {{ report.vlan_name }}
action: migrate
service_type: {{ report.inferred_service_type | default(report.service_type | default('l3')) }}
vlan_name: {{ report.vlan_name_on_box | default(report.vlan_name) }}
vrf: {{ report.discovered_vrf | default(report.vrf | default('default')) }}
{% if report.gateway | default('') | length > 0 %}
gateway: {{ report.gateway }}
{% endif %}
{% if report.prefixes | default([]) | length > 0 %}
prefixes:
{% for prefix in report.prefixes %}
  - {{ prefix }}
{% endfor %}
{% endif %}
vni: 0  # TODO: assign before migration
target_switches:
{{ (report.snippet_target_switches | default(report.target_switches | default([]))) | map('regex_replace', '^', '  - ') | join('\n') if (report.snippet_target_switches | default(report.target_switches | default([]))) | length > 0 else '  []  # TODO: set EOS CVP deploy targets' }}
discovery_switches:
{{ (report.snippet_discovery_switches | default(report.switches_vlan_defined | default(report.switches_found | default([])))) | map('regex_replace', '^', '  - ') | join('\n') if (report.snippet_discovery_switches | default(report.switches_vlan_defined | default([]))) | length > 0 else '  []' }}
{% if report.svi_inventory | default([]) | length > 0 %}
# Discovered SVIs (human prune of L3 uses this list — not automated)
# VRF may be shared with other VLANs — do not delete VRF/BGP/statics for this VLAN alone
{% for svi in report.svi_inventory %}
#   {{ svi.hostname }}: vrf={{ svi.vrf }} ips={{ svi.ip_addresses | default([]) | join(',') }} gw={{ (svi.virtual_router_addresses | default([]) + svi.hsrp_addresses | default([])) | join(',') }}
{% endfor %}
{% endif %}
{% if report.l3_discovery.present | default(false) %}
# L3 discovery: VRF(s)={{ report.l3_discovery.vrfs | default([]) | join(',') }} gateway={{ report.gateway | default('') }}
{% endif %}
