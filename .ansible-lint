---
# Ansible Lint configuration
# Run with: ansible-lint   or   make lint

profile: production

exclude_paths:
  - .local/
  - .git/
  - .venv/
  - backups/
  - collections/
  - reports/
  - .github/
  - .molecule/
  # Test-only shadow collection; not a publishable collection.
  - tests/mock_cli/ansible_collections/

# vars/vlans/ and vars/services/ hold per-VLAN / per-service data records
# loaded by the load_vlan_db_from_directory / load_service_from_directory
# filters, not Ansible variable files, so keys like name/action/order are
# record fields. Lint them as plain YAML instead of as vars files.
kinds:
  - yaml: "vars/vlans/**/*.yml"
  - yaml: "vars/services/**/*.yml"

warn_list:
  - experimental
  - yaml[line-length]

skip_list:
  - name[casing]
  # Repo convention: role-internal variables and facts start with an underscore
  # and a short domain prefix (_eos_*, _nxos_*, _disc_*, _border_bgp_*, ...)
  # instead of the role name. Several are read by playbooks and other roles via
  # hostvars['localhost'], so renaming them is not a lint-only change.
  - var-naming[no-role-prefix]
  # Network CLI gather/discovery tasks intentionally use changed_when: false
  - no-changed-when
  # jinja[spacing] noise on long filter pipes; keep intentional style
  - jinja[spacing]

use_default_rules: true
