{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vxlan-migration.local/schemas/vlan_record.schema.json",
  "title": "VLAN migration record",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "name", "action", "service_type"],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4094
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "enum": ["migrate", "decommission"]
    },
    "service_type": {
      "type": "string",
      "enum": ["l2", "l3"],
      "description": "l3 when the gateway is inside the VXLAN fabric; l2 when it stays outside."
    },
    "protected_vlan": { "type": "boolean" },
    "gateway_leafs": {
      "type": "array",
      "description": "Engineer-supplied fabric leaves that will host the gateway. Never inferred from discovery.",
      "items": { "type": "string", "minLength": 1 }
    },
    "vlan_name": { "type": "string" },
    "vni": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 16777215
    },
    "vrf": { "type": "string" },
    "mcast_group": { "type": "string" },
    "gateway": { "type": "string" },
    "prefixes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "target_switches": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "discovery_switches": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "_meta": { "type": "object" },
    "_from_service": { "type": "string" },
    "_source_file": { "type": "string" }
  }
}
